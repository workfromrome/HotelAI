# Create .env from this file and set your Google AI Studio and Groq keys.
GOOGLE_API_KEY=replace_me
GROQ_API_KEY=replace_me
LLM_PROVIDER=google
EMBEDDING_PROVIDER=google
GOOGLE_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=gemini-embedding-001
REQUEST_DELAY_SECONDS=1
GEMINI_REQUESTS_PER_MINUTE=5
GROQ_REQUESTS_PER_MINUTE=30
MAX_RETRIES=4
# Comma-separated origins allowed to call the API. Add your deployed frontend URL
# (e.g. https://your-site.netlify.app) alongside the local dev origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
